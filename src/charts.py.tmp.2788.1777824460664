import streamlit as st
import plotly.express as px
import pandas as pd

COLORS = ["#2563EB", "#7C3AED", "#059669", "#D97706", "#DC2626", "#0891B2"]

_LAYOUT = dict(margin=dict(t=40, b=0, l=0, r=0), plot_bgcolor="white", paper_bgcolor="white")


def render_chart(chart):
    if not chart or not chart.get("type"):
        return
    chart_df = pd.DataFrame({"label": chart["labels"], "value": chart["values"]})
    title = chart.get("title", "")
    chart_type = chart["type"]

    if chart_type == "bar":
        fig = px.bar(chart_df, x="label", y="value", title=title, color_discrete_sequence=COLORS)
    elif chart_type == "line":
        fig = px.line(chart_df, x="label", y="value", title=title, color_discrete_sequence=COLORS)
    elif chart_type == "doughnut":
        fig = px.pie(chart_df, names="label", values="value", title=title, hole=0.4, color_discrete_sequence=COLORS)
    else:
        return

    fig.update_layout(**_LAYOUT)
    st.plotly_chart(fig, use_container_width=True)


def render_correlation_heatmap(df):
    numeric_df = df.select_dtypes(include="number")
    if len(numeric_df.columns) < 2:
        st.info("Need at least 2 numeric columns for a correlation matrix.")
        return
    corr = numeric_df.corr().round(2)
    fig = px.imshow(
        corr,
        color_continuous_scale="RdBu_r",
        zmin=-1,
        zmax=1,
        text_auto=True,
        aspect="auto",
    )
    fig.update_layout(margin=dict(t=10, b=0, l=0, r=0))
    st.plotly_chart(fig, use_container_width=True)
