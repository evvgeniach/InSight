import streamlit as st
import plotly.express as px
import pandas as pd


def render_chart(chart):
    if not chart or not chart.get("type"):
        return
    chart_df = pd.DataFrame({"label": chart["labels"], "value": chart["values"]})
    title = chart.get("title", "")
    chart_type = chart["type"]

    if chart_type == "bar":
        fig = px.bar(chart_df, x="label", y="value", title=title)
    elif chart_type == "line":
        fig = px.line(chart_df, x="label", y="value", title=title)
    elif chart_type == "doughnut":
        fig = px.pie(chart_df, names="label", values="value", title=title, hole=0.4)
    else:
        return

    st.plotly_chart(fig, use_container_width=True)
